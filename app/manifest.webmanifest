{
  "name": "MusicGen — generative composer",
  "short_name": "MusicGen",
  "description": "A pocket-sized generative composer. Finished-sounding, reproducible, exportable music in one tap. No accounts, no server, no samples.",
  "start_url": "./?src=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0b0e17",
  "theme_color": "#0b0e17",
  "categories": [
    "music",
    "entertainment",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Random song",
      "short_name": "Random",
      "url": "./?action=random"
    },
    {
      "name": "Play last",
      "short_name": "Play",
      "url": "./?action=play"
    }
  ]
}